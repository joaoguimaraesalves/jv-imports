# Connection string do Neon
# Neon Dashboard -> seu projeto -> Connection Details -> copie a "Connection string"
# (deixe a opção "Pooled connection" marcada para uso com web app)
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Senha do painel (/painel). Mínimo 6 caracteres. Sem ela ninguém entra no painel.
# No Render: Dashboard → serviço → Environment → Add Environment Variable.
PAINEL_SENHA=troque-por-uma-senha-forte

# Loja na Cloudflare (ver README "Ligar a loja na Cloudflare").
# Sem estas três, a loja é servida pelo próprio Render.
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=        (permissão: Account · Workers KV Storage · Edit)

# Endereço público da loja. Quem abrir a loja pelo Render é levado para cá.
# Ex.: https://jv-imports.pages.dev ou https://seudominio.com.br
# SITE_URL=
